# Copy to .env.local and fill in. Used by both the Expo app and the Next.js web version
# (web/next.config.mjs reads this repo-root file). On Vercel, add the same two variables in
# Project Settings -> Environment Variables.
#
# Both values are public (they ship inside the app), so they're safe in a browser bundle.
# Never put a service-role key or the Anthropic key here; those live only in Supabase
# (Edge Function secrets).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-public-key
